# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Model used by all four agents (validated at startup)
HUNTER_MODEL=gpt-4.1-mini

# OpenAI Agents SDK tracing sends prompts/tool IO to OpenAI's trace backend. Off until reviewed.
HUNTER_TRACING=false
HUNTER_LOG_LEVEL=INFO

# Browser
HUNTER_HEADLESS=false
HUNTER_PROFILE_DIR=./data/profile
HUNTER_DATA_DIR=./data
# Blank = try installed Chrome, then Edge, then Playwright's bundled Chromium.
# Managed machines often refuse to execute the bundled Chromium under AppData; Chrome is used then.
# HUNTER_BROWSER_CHANNEL=chrome

# Destination
HUNTER_COUNTRY=JO
HUNTER_CURRENCY=JOD

# Web
HUNTER_HOST=127.0.0.1
HUNTER_PORT=8765
